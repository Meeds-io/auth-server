<configuration
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd http://www.exoplatform.org/xml/ns/kernel_1_3.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd">
  <component>
    <key>mcp-server-oauth2-properties</key>
    <type>org.exoplatform.container.ExtendedPropertyConfigurator</type>
    <init-params>
      <properties-param>
        <name>mcp-server-oauth2-properties</name>
        <description>MCP Server Oauth2 Properties</description>
        <property name="meeds.oauth.app.scopes.profile" value="profile" />
        <property name="meeds.oauth.app.audiences.test" value="https://auth.example.test/test-app" />
      </properties-param>
    </init-params>
  </component>

  <remove-configuration>org.exoplatform.services.rest.impl.provider.JAXBContextResolver</remove-configuration>
</configuration>
